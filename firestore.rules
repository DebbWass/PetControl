rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is a member of the given family
    function isFamilyMember(familyId) {
      return request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // Family document itself
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      // Only owner can update family metadata (name, inviteCode, etc.)
      allow update: if isFamilyMember(familyId);
      // Only allow create if auth user will be the owner
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false; // Never delete families

      // Members sub-collection
      match /members/{userId} {
        allow read: if isFamilyMember(familyId);
        // Users can only write their own member document
        allow write: if request.auth != null && request.auth.uid == userId &&
          isFamilyMember(familyId);
      }

      // Pets and all their sub-collections
      match /pets/{petId} {
        allow read, write: if isFamilyMember(familyId);

        match /weights/{weightId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /medications/{medicationId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /vaccines/{vaccineId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /treatments/{treatmentId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /appointments/{appointmentId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /food/{foodId} {
          allow read, write: if isFamilyMember(familyId);
        }
      }
    }
  }
}
