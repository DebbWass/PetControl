rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is a member of the given family
    function isFamilyMember(familyId) {
      return request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // Top-level user index: maps uid → familyId (allows login without querying all families)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Family document itself
    match /families/{familyId} {
      // Direct read requires membership; list (query) is allowed for authenticated
      // users so they can look up a family by invite code during registration.
      allow get: if isFamilyMember(familyId);
      allow list: if request.auth != null;
      // Members can update family metadata; also allow a non-member to add themselves via invite code
      allow update: if isFamilyMember(familyId) ||
        (request.auth != null &&
         request.resource.data.inviteCode == resource.data.inviteCode &&
         request.resource.data.ownerUid == resource.data.ownerUid &&
         request.auth.uid in request.resource.data.memberUids &&
         !(request.auth.uid in resource.data.memberUids));
      // Only allow create if auth user will be the owner
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false; // Never delete families

      // Members sub-collection
      match /members/{userId} {
        allow read: if isFamilyMember(familyId);
        // Allow creating your own member doc (needed during registration before isFamilyMember resolves)
        allow create: if request.auth != null && request.auth.uid == userId;
        // Updates and deletes require active family membership
        allow update, delete: if request.auth != null && request.auth.uid == userId &&
          isFamilyMember(familyId);
      }

      // Pets and all their sub-collections
      match /pets/{petId} {
        allow read, write: if isFamilyMember(familyId);

        match /weights/{weightId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /medications/{medicationId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /vaccines/{vaccineId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /treatments/{treatmentId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /appointments/{appointmentId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /food/{foodId} {
          allow read, write: if isFamilyMember(familyId);
        }
        match /documents/{documentId} {
          allow read, write: if isFamilyMember(familyId);
        }
      }
    }
  }
}
